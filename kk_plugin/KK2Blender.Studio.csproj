<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The CharaStudio plugin. Builds for net35 (KK's Unity 5.6 Mono) against reference assemblies from
    the IllusionMods and BepInEx NuGet feeds, so no game files are needed to build it (CI builds it).
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>KK2Blender.Studio</AssemblyName>
    <RootNamespace>KK2Blender</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.6</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <!-- Shader property names per shader (tools/build_shader_table.py): Unity 5.6 can't list them. -->
    <EmbeddedResource Include="data/shader-properties.json" LogicalName="KK2Blender.ShaderProperties.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.Koikatu.Assembly-CSharp" Version="2019.4.27.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="IllusionLibs.Koikatu.Assembly-CSharp-firstpass" Version="2019.4.27.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine" Version="5.6.2.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine.UI" Version="5.6.2.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="IllusionLibs.BepInEx" Version="5.4.22" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="IllusionLibs.BepInEx.Harmony" Version="2.9.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="IllusionModdingAPI.KKAPI" Version="1.42.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
